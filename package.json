{
	"name": "inut-ap-process",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.3",
	"engines": {
		"node": ">=22 <23"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"verify:trello-read": "node --env-file-if-exists=.env --import tsx scripts/verify-trello-read.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.4",
		"hono": "^4.8.3",
		"lz-string": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
